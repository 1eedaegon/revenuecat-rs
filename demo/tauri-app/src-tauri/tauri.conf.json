{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "revenuecat-rs-demo",
  "version": "0.1.0",
  "identifier": "dev.gon.revenuecat-rs.demo",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "revenuecat-rs × Tauri — Test Store demo",
        "width": 1040,
        "height": 740,
        "minWidth": 780,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png",
      "icons/32x32.png"
    ]
  }
}